# ============================================================
# Dispara — variáveis de ambiente
# Copie para .env.local e preencha os valores.
# ============================================================

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Upstash QStash (obrigatório — filas de disparo) ---
QSTASH_TOKEN=

# --- Autenticação ---
# Senha de login do dashboard
MASTER_PASSWORD=
# Chave da REST API (Authorization: Bearer / X-API-Key)
DISPARA_API_KEY=
# Chave dos endpoints administrativos (/api/database/*, /api/vercel/*)
DISPARA_ADMIN_KEY=

# --- WhatsApp Cloud API (opcional — fallback se não configurado via UI) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- IA (opcional) ---
GEMINI_API_KEY=
MEM0_API_KEY=
